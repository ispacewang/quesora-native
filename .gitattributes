/.github/workflows/*.yml text eol=lf
/qa/*.py text eol=lf
/qa/winres/*.go text eol=lf
/qa/winres/go.mod text eol=lf
/qa/winres/go.sum text eol=lf
*.png -text
*.gz -text
*.xls -text
